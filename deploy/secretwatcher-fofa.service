[Unit]
Description=SecretWatcher scheduled passive FOFA import
After=network-online.target secretwatcher.service
Wants=network-online.target

[Service]
Type=oneshot
User=secretwatcher
Group=secretwatcher
WorkingDirectory=/opt/secretwatcher/current
Environment="PATH=/opt/secretwatcher/venv/bin:/usr/bin:/bin"
Environment="SECRETWATCHER_DB=/var/lib/secretwatcher/secretwatcher.db"
EnvironmentFile=/etc/secretwatcher/fofa.env
ExecStart=/opt/secretwatcher/venv/bin/python /opt/secretwatcher/current/scripts/import_fofa.py "title=\"DeepTutor\" || title=\"Dify\" || title=\"Open WebUI\" || title=\"AnythingLLM\" || title=\"LobeChat\" || title=\"LibreChat\" || title=\"FastGPT\" || title=\"RAGFlow\"" --size 100
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/secretwatcher

