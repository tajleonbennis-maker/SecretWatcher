[Unit]
Description=SecretWatcher public-interest security platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secretwatcher
Group=secretwatcher
WorkingDirectory=/opt/secretwatcher/current
Environment="PATH=/opt/secretwatcher/venv/bin:/usr/bin:/bin"
Environment="SECRETWATCHER_DB=/var/lib/secretwatcher/secretwatcher.db"
Environment="PUBLIC_SITE_URL=https://www.cyberstroll.top"
EnvironmentFile=-/etc/secretwatcher/admin.env
ExecStart=/opt/secretwatcher/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8092 --workers 1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/secretwatcher

[Install]
WantedBy=multi-user.target
