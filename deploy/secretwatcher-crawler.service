[Unit]
Description=SecretWatcher JavaScript exposure crawler
After=network-online.target secretwatcher.service
Wants=network-online.target

[Service]
Type=oneshot
User=secretwatcher
Group=secretwatcher
WorkingDirectory=/opt/secretwatcher/current
Environment="PATH=/opt/secretwatcher/venv/bin:/usr/bin:/bin"
Environment="SECRETWATCHER_DB=/var/lib/secretwatcher/secretwatcher.db"
EnvironmentFile=/etc/secretwatcher/scanner.env
ExecStart=/opt/secretwatcher/venv/bin/python /opt/secretwatcher/current/scripts/crawl_assets.py --limit 30
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/secretwatcher

[Install]
WantedBy=multi-user.target
