server {
    listen 80;
    listen [::]:80;
    server_name cyberstroll.top www.cyberstroll.top;

    location ^~ /.well-known/acme-challenge/ {
        proxy_pass http://165.154.226.119;
        proxy_set_header Host $host;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name cyberstroll.top www.cyberstroll.top;

    ssl_certificate /etc/letsencrypt/live/cyberstroll.top/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/cyberstroll.top/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    location ^~ /api/admin/scan/ {
        proxy_pass https://165.154.226.119;
        proxy_ssl_server_name on;
        proxy_ssl_name www.cyberstroll.top;
        proxy_set_header Host www.cyberstroll.top;
        proxy_set_header Authorization $http_authorization;
        proxy_connect_timeout 3s;
        proxy_read_timeout 3600s;
        proxy_buffering off;
    }

    # Public findings and aggregate statistics must come from the scanner's
    # authoritative database on node-a, otherwise DNS round-robin nodes drift.
    location ^~ /api/public/ {
        proxy_pass https://165.154.226.119;
        proxy_ssl_server_name on;
        proxy_ssl_name www.cyberstroll.top;
        proxy_set_header Host www.cyberstroll.top;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }

    # Evidence screenshots live only on node-a's local filesystem.
    location ^~ /evidence/ {
        proxy_pass https://165.154.226.119;
        proxy_ssl_server_name on;
        proxy_ssl_name www.cyberstroll.top;
        proxy_set_header Host www.cyberstroll.top;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }

    location / {
        proxy_pass http://127.0.0.1:8092;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 30s;
    }

    location = /health {
        proxy_pass http://127.0.0.1:8092/health;
        access_log off;
    }

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-Frame-Options "DENY" always;
}
